/* voipstoreerrorcodes.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* VOIP_E_ALREADYINITIALIZED
 * row: VOIP_E_ALREADYINITIALIZED = 0x80cc0003 There is no caller info DB or no call log DB. The manager will still work, but the DB functionality is lost.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_ALREADYINITIALIZED 0x80cc0003

/* VOIP_E_ENUMOUTOFDATE
 * row: VOIP_E_ENUMOUTOFDATE = 0x80cc0000 The IVoIPCallLogDBEnum or IVoIPCallerInfoDBEnum pointer that was used to make this call is out of date. Before further calls will succeed, the enumerator must be reset.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_ENUMOUTOFDATE 0x80cc0000

/* VOIP_E_NODB
 * row: VOIP_E_NODB = 0x80cc0004 Database does not exist. It can also mean that the database is not initialized.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_NODB 0x80cc0004

/* VOIP_E_NOTINITIALIZED
 * row: VOIP_E_NOTINITIALIZED = 0x80cc0001 The interface was not initialized.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_NOTINITIALIZED 0x80cc0001

/* VOIP_E_RECORDNOTINDB
 * row: VOIP_E_RECORDNOTINDB = 0x80cc0002 The IVoIPCallRecord or IVoIPCallerInfoRecord pointer is not in any database and therefore is not removable.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_RECORDNOTINDB 0x80cc0002

/* VOIP_E_TIMENOTSET
 * row: VOIP_E_TIMENOTSET = 0x80cc0008 The time has not been set.
 * source: corpus/learn/windows-embedded-ce-6.0/ee500428(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VOIP_E_TIMENOTSET 0x80cc0008
