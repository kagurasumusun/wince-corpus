/* sideshow.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* ERROR_BAD_LENGTH
 * row: ERROR_BAD_LENGTH (24) Buffer was too small, check lpuiItemSize.
 * source: corpus/learn/windows-ce-5.0/cc700961(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define ERROR_BAD_LENGTH 24

/* ERROR_INVALID_PARAMETER
 * row: ERROR_INVALID_PARAMETER (87) A required parameter was NULL or unmappable.
 * source: corpus/learn/windows-ce-5.0/cc700961(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define ERROR_INVALID_PARAMETER 87

/* ERROR_NO_MORE_FILES
