/* VT_ARRAY
 * row: VT_ARRAY 0x2000 Parray If the type indicator is combined with VT_ARRAY by an OR operator, the value is a pointer to a SAFEARRAY. VT_ARRAY can use the OR with the following data types: VT_I1, VT_UI1, VT_I2, VT_UI2, VT_I4, VT_UI4, VT_INT, VT_UINT, VT_R4, VT_R8, VT_BOOL, VT_DECIMAL, VT_ERROR, VT_CY, VT_DATE, VT_BSTR, VT_DISPATCH, VT_UNKNOWN, and VT_VARIANT. VT_ARRAY cannot use OR with VT_VECTOR.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489607(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VT_ARRAY 0x2000

/* VT_BLOB
 * row: VT_BLOB 65 blob DWORD count of bytes, followed by that many bytes of data. The byte count does not include the four bytes for the length of the count itself; an empty blob member would have a count of zero, followed by zero bytes. This is similar to the value VT_BSTR, but does not guarantee a null byte at the end of the data.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489607(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VT_BLOB 65

/* VT_BLOBOBJECT
 * row: VT_BLOBOBJECT 70 blob A blob member containing a serialized object in the same representation that would appear in VT_STREAMED_OBJECT. That is, a DWORD byte count (where the byte count does not include the size of itself) which is in the format of a class identifier followed by initialization data for that class.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489607(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VT_BLOBOBJECT 70

/* VT_BOOL
 * row: VT_BOOL 11 boolVal (bool in earlier designs) Boolean value, a WORD containing 0 (FALSE) or -1 (TRUE).
 * source: corpus/learn/windows-embedded-ce-6.0/ee489607(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VT_BOOL 11

/* VT_BSTR
 * row: VT_BSTR 8 bstrVal Pointer to a null-terminated Unicode string. The string is immediately preceded by a DWORD representing the byte count, but bstrVal points past this DWORD to the first character of the string. BSTRs must be allocated and freed using the Automation SysAllocString and SysFreeString calls.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489607(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define VT_BSTR 8

/* VT_BSTR_BLOB
 * row: VT_BSTR_BLOB 0xfff bstrblobVal For system use only.
