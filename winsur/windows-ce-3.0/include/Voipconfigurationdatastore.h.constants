/* Voipconfigurationdatastore.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* CONFIG_DATA_EXCHANGE_HTTPPROXY
 * row: CONFIG_DATA_EXCHANGE_HTTPPROXY = 0x0400 HTTP proxy to use when connecting to the Exchange server, if necessary. No proxy is used if this value is not set. For example, "myhttpproxy". XML element and registry entry name: exchange_http_proxy LDAP name: CEVoIP-HTTPProxy
 * source: corpus/chm/windows-ce-5.0/wcevail5/html/wce50lrfCONFIG_DATA_.html  borrowed from chm
 * row: CONFIG_DATA_EXCHANGE_HTTPPROXY = 0x0400 HTTP proxy to use when connecting to the Exchange server, if necessary. No proxy is used if this value is not set. For example, "myhttpproxy". XML element and registry entry name: exchange_http_proxy LDAP name: CEVoIP-HTTPProxy
 * source: corpus/learn/windows-ce-5.0/ms909304(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define CONFIG_DATA_EXCHANGE_HTTPPROXY 0x0400

/* CONFIG_DATA_EXCHANGE_OWASERVER
 * row: CONFIG_DATA_EXCHANGE_OWASERVER = 0x0200 URL to access the Exchange Outlook Web Access (OWA) service. For example, "https://mail.mycompany.com". XML element and registry entry name: exchange_owaserver LDAP name: CEVoIP-OWAServer
 * source: corpus/chm/windows-ce-5.0/wcevail5/html/wce50lrfCONFIG_DATA_.html  borrowed from chm
 * row: CONFIG_DATA_EXCHANGE_OWASERVER = 0x0200 URL to access the Exchange Outlook Web Access (OWA) service. For example, "https://mail.mycompany.com". XML element and registry entry name: exchange_owaserver LDAP name: CEVoIP-OWAServer
 * source: corpus/learn/windows-ce-5.0/ms909304(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define CONFIG_DATA_EXCHANGE_OWASERVER 0x0200

/* CONFIG_DATA_PHONE_INFO_AREACODES
 * row: CONFIG_DATA_PHONE_INFO_AREACODES = 0x0002 Local area codes. Multiple area codes must be separated by semi-colons. For example, "425;206;". XML element and registry entry name: local_area_codes LDAP name: CEVoIP-LocalAreaCodes
 * source: corpus/chm/windows-ce-5.0/wcevail5/html/wce50lrfCONFIG_DATA_.html  borrowed from chm
 * row: CONFIG_DATA_PHONE_INFO_AREACODES = 0x0002 Local area codes. Multiple area codes must be separated by semi-colons. For example, "425;206;". XML element and registry entry name: local_area_codes LDAP name: CEVoIP-LocalAreaCodes
 * source: corpus/learn/windows-ce-5.0/ms909304(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define CONFIG_DATA_PHONE_INFO_AREACODES 0x0002

