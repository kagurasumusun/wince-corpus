    sprintf                         ; function  CE 3.0..399, 5.0..599  corpus/learn/windows-ce-5.0/ms860374(v=msdn.10).html
    sscanf                          ; function  CE 3.0..399, 5.0..599  corpus/learn/windows-ce-5.0/ms860379(v=msdn.10).html
    vsprintf                        ; function  CE 3.0..399, 5.0..599  corpus/learn/windows-ce-5.0/ms861422(v=msdn.10).html
