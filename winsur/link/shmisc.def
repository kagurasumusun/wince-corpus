; shmisc -- EXPORTS worklist for the whole of Windows CE
; (one tree across generations; see include/ for the rest).
;
; The version range of a line is a COMMENT -- the .def
; grammar has no conditionals: filter the line for the
; version you target with the range printed beside it.
; Names are the documented names, not the _Name@N
; decorated symbols the documentation does not print.
;
; stated as: Shmisc.lib, shmisc.lib
; 2 name(s)
EXPORTS
    SHLoadDIBitmap                  ; function  CE 1.0..199, 2.11..2.12, 3.0..399, 5.0..699  corpus/learn/windows-embedded-ce-6.0/ee505632(v=winembedded.60).html
    SHShowOutOfMemory               ; function  CE 1.0..199, 2.11..2.12, 3.0..399, 5.0..699  corpus/learn/windows-embedded-ce-6.0/ee499745(v=winembedded.60).html
