/*--------------------------------------------------------------------
 * RTC_SUBSCRIPTION_STATE  [enum]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee500723(v=winembedded.60).html
 */
typedef enum RTC_SUBSCRIPTION_STATE
{
 RTCSUBC_NOT_SUBSCRIBED, 
 RTCSUBC_SUBSCRIBING,
 RTCSUBC_SUBSCRIBED, 
 RTCSUBC_LOGGED_OFF,
 RTCSUBC_ERROR,
 RTCSUBC_UNSUBSCRIBING, 
} RTC_SUBSCRIPTION_STATE;
#endif /* _WIN32_WCE */

