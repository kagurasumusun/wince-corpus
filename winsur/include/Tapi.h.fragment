/* quoted (cell): LINETRANSLATERESULT_INTERNATIONAL = 0x00000002 Indicates that the call is being treated as an international call. Country/region code specified in the destination address is different from the country/region code specified for the CurrentLocation.  [+3 more row(s)] */
#define LINETRANSLATERESULT_INTERNATIONAL 0x00000002

