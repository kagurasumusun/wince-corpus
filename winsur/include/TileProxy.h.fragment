#ifndef _TILEPROXY_
#define _TILEPROXY_



HRESULT CreateTileProxy( HWND hParentWnd, HWND hHtmlWnd, WNDPROC pfnWndProc, LPVOID pCreateParam, HANDLE* phTileProxy);
HRESULT ReleaseTileProxy( HANDLE hTileProxy);
LRESULT CALLBACK WindowProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
  switch (uMsg)
  {
    case WM_TILE_EVENT:
    switch(wParam)
    {
      case TILE_EVENT_HTMLTHREAD_PRIORITY_NORMAL:
      GetWebBrowser()->SetBelowNormalPriority(false);
      break;
      case TILE_EVENT_HTMLTHREAD_PRIORITY_BELOWNORMAL:
      GetWebBrowser()->SetBelowNormalPriority(true);
      break;
      case TILE_EVENT_PAGEDOCSIZE_CHANGE:
      float fViewScale;
      CHR(TPGetViewScale(m_hTileProxy, &fViewScale));
      CBR(fViewScale > 0.0f);
      SIZE szDoc;
      CHR(TPGetViewDocSize(m_hTileProxy, &szDoc));
      szDoc.cx /= fViewScale;
      szDoc.cy /= fViewScale;
      break;
      case TILE_EVENT_PAGE_CHANGE:
      GetWebBrowser()->OnPageChanged(*(reinterpret_cast(lParam)));
      break;
    }
    return 1;
  }
  return DefWindowProc(hWnd, uMsg, wParam, lParam);
}
HRESULT TPChangePos( HANDLE hTileProxy, INT32 dxPage, INT32 dyPage);
HRESULT TPChangeZoom( HANDLE hTileProxy, POINT ptHitPoint,  RECT* pZoomRect,  BOOL bAllowVerticalZoom);
HRESULT TPChangeZoomScale( HANDLE hTileProxy, float fScale);
HRESULT TPForwardWindowInput( HANDLE hTileProxy, UINT32 msg,  POINT pt);
HRESULT TPGetHostWindow( HANDLE hTileProxy, HWND* phWnd);
HRESULT TPGetIsChanging( HANDLE hTileProxy, BOOL* pIsChanging);
HRESULT TPGetViewDocSize( HANDLE hTileProxy, SIZE* pDocSize);
HRESULT TPGetViewPosition( HANDLE hTileProxy, float* px, float* py);
HRESULT TPGetViewScale( HANDLE hTileProxy, float* pViewscale);
HRESULT TPGetViewVisBounds( HANDLE hTileProxy, RECT* pRect);
HANDLE hTileProxy;
CreateTileProxy(hWnd, hHtml, pfnWndProc, NULL, &hTileProxy);
HANDLE handles[1];
UINT32 itimeout;
MSG msg;
bool running = true;
TPGetWaitEvent(hTileProxy, & handles[0]);
while (running)
{
  TPGetWaitTimeout(hTileProxy, &iTimeout);
  MsgWaitForMultipleObjectsEx(1, handles, timeout, QS_ALLINPUT, MWMO_INPUTAVAILABLE);
  while (PeekMessage(&msg, NULL, 0, 0, PM_REMOVE | PM_NOYIELD))
  {
    DispatchMessage(&msg);
    if (msg.message == WM_QUIT)
    {
      running = false;
      break;
    }
  }
  TPUpdate(hTileProxy);
}
HRESULT TPGetWaitTimeout( HANDLE hTileProxy, UINT32* piTimeout);
HRESULT TPRedraw( HANDLE hTileProxy);
HRESULT TPSetHtmlWindow( HANDLE hTileProxy, HWND hWnd);
HRESULT TPSetPageChanged( HANDLE hTileProxy);
HRESULT TPSetView( HANDLE hTileProxy, POINT ptScrollPosition, float fZoomFactor);
HRESULT TPSetViewPosition( HANDLE hTileProxy, float x, float y);
HRESULT TPShowTileWindow( __in HANDLE hTileProxy, __in BOOL bShow);
HRESULT TPUpdate( HANDLE hTileProxy);
HRESULT TPWindowToPage( HANDLE hTileProxy, INT32* px, INT32* py);

