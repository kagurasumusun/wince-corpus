HRESULT hr = DMOEnum(
DMOCATEGORY_AUDIO_EFFECT,
DMO_ENUMF_INCLUDE_KEYED,
0, NULL,
0, NULL,
&pEnum);
if (SUCCEEDED(hr))
{
  CLSID clsidDMO;
