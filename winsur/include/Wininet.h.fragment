typedef struct {DWORDdwResult;DWORDdwError;} INTERNET_ASYNC_RESULT, *LPINTERNET_ASYNC_RESULT;
typedef struct _INTERNET_BUFFERS {DWORDdwStructSize;_INTERNET_BUFFERS* Next;LPCTSTRlpcszHeader;DWORDdwHeadersLength;DWORDdwHeadersTotal;LPVOIDlpvBuffer;DWORDdwBufferLength;DWORDdwBufferTotal;DWORDdwOffsetLow;DWORDdwOffsetHigh;} INTERNET_BUFFERS, *LPINTERNET_BUFFERS;
