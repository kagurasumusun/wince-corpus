#ifndef _HTIFRAME_IDL_
#define _HTIFRAME_IDL_


/* ==================================================================
 * constants (one evidence comment per #define; the
 * #if of a batch covers every #define in it; values
 * that differ per generation pool into #if/#elif
 * chains with the evidence after the #endif)
 * ================================================================ */

#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 500 && _WIN32_WCE < 600)) /* CE 5.0..599 */

#define FINDFRAME_INTERNAL 0x80000000

#define FINDFRAME_JUSTTESTEXISTENCE 1

#define FINDFRAME_NONE 0

#define FRAMEOPTIONS_BROWSERBAND 0x00000040

#define FRAMEOPTIONS_DESKTOP 0x00000020

#define FRAMEOPTIONS_NO3BORDER 0x00000010

#define FRAMEOPTIONS_NORESIZE 0x00000008

#define FRAMEOPTIONS_SCROLL_AUTO 0x00000004

#define FRAMEOPTIONS_SCROLL_NO 0x00000002

#define FRAMEOPTIONS_SCROLL_YES 0x00000001
#endif /* _WIN32_WCE */


typedef enum {
  FINDFRAME_NONE = 0,
  FINDFRAME_JUSTTESTEXISTENCE = 1,
  FINDFRAME_INTERNAL = 0x80000000
} FINDFRAME_FLAGS;
typedef enum {
  FRAMEOPTIONS_SCROLL_YES = 0x00000001,
  FRAMEOPTIONS_SCROLL_NO = 0x00000002,
  FRAMEOPTIONS_SCROLL_AUTO = 0x00000004,
  FRAMEOPTIONS_NORESIZE = 0x00000008,
  FRAMEOPTIONS_NO3BORDER = 0x00000010,
  FRAMEOPTIONS_DESKTOP = 0x00000020,
  FRAMEOPTIONS_BROWSERBAND = 0x00000040
} FRAMEOPTIONS_FLAGS;

#endif /* _HTIFRAME_IDL_ */
