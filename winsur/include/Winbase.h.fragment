{
  LPTSTR pszBuf=NULL;
  pszBuf = (LPTSTR)LocalAlloc(
  LPTR,
  MAX_PATH*sizeof(TCHAR));
  if( pszBuf == NULL )
  {
    _tprintf(TEXT("LocalAlloc failed (%d)\n"), GetLastError());
