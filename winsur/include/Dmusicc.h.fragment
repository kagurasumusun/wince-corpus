HRESULT EnumInstrument( DWORD dwIndex, DWORD* pdwPatch, LPWSTR pwszName, DWORD dwNameLen );
HRESULT GetInstrument( DWORD dwPatch, IDirectMusicInstrument** ppInstrument );
HRESULT GetBuffer( void** ppvBuffer, DWORD* pdwSize );
HRESULT myRemappedDownload(
IDirectMusicCollection *pCollection,
IDirectMusicPort *pPort,
IDirectMusicDownloadedInstrument **ppDLInstrument,
BYTE bMSB,
DWORD dwPatch)
{
  HRESULT hr;
  IDirectMusicInstrument* pInstrument;
  hr = pCollection->GetInstrument(dwPatch, &pInstrument);
  if (SUCCEEDED(hr))
  {
    dwPatch &= 0xFF00FFFF;
    dwPatch |= bMSB SetPatch(dwPatch);
    hr = pPort->DownloadInstrument(pInstrument,
    ppDLInstrument,
    NULL, 0);
    pInstrument->Release();
  }
  return hr;
}
