char string[] = "A string\tof ,,tokens\nand some more tokens";
char seps[] = " ,\t\n";
char *token;
void main( void )
{
  printf( "%s\n\nTokens:\n", string );
  token = strtok( string, seps );
  while( token != NULL )
  {
    printf( " %s\n", token );
    token = strtok( NULL, seps );
  }
}
