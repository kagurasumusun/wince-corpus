i_lpszBase,
i_ulScope,
i_lpszSearchFilter,
lpszAttributes,
0,
lpsTimeout,
&pMsg
);
if (lpszAttributes != NULL)
delete [] lpszAttributes;
if (dwErr != LDAP_SUCCESS)
{
  DebugOutLDAPError(i_pldap, dwErr, _T("ldap_search_st"));
  hr = HRESULT_FROM_WIN32(dwErr);
  if (pMsg != NULL)
  ldap_msgfree(pMsg);
}
else
{
  ...
  if (pMsg != NULL) ldap_msgfree(pMsg);
}
