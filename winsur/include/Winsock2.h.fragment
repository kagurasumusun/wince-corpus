SOCKADDR_BTH sab;
int len = sizeof(sab);
if (0 == getpeername (s, &sab, &len)) {
  wprintf (L"Remote Bluetooth device is %04x%08x, connected to %d\n",
  GET_NAP(sab.btAddr), GET_SAP(sab.btAddr), sab.port);
}
SOCKADDR_BTH sab;
int len = sizeof(sab);
if (0 == getsockname (s, &sab, &len)) {
  wprintf (L"Local Bluetooth device is %04x%08x, server channel = %d\n",
  GET_NAP(sab.btAddr), GET_SAP(sab.btAddr), sab.port);
}
