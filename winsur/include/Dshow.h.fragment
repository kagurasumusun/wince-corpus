hr = pCompress->GetInfo(NULL, &cbVersion, NULL, &cbDesc,
NULL, NULL, NULL, NULL);
if (SUCCEEDED(hr))
{
  WCHAR *pszVersion = new WCHAR[cbVersion / sizeof(WCHAR)];
  WCHAR *pszDesc = new WCHAR[cbDesc / sizeof(WCHAR)];
  hr = pCompress->GetInfo(pszVersion, &cbVersion, pszDesc, &cbDesc,
  NULL, NULL, NULL, NULL);
}
delete [] pszVersion;
delete [] pszDesc;
}
