/*--------------------------------------------------------------------
 * D3DMXDivFxd  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee490300(v=winembedded.60).html
 */
#define D3DMXDivFxd( fxdA, fxdB ) ((FIXED) \
 (((_int64)(fxdA) << 16) / (_int64)(fxdB)))

/*--------------------------------------------------------------------
 * D3DMXMulFxd  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491516(v=winembedded.60).html
 */
#define D3DMXMulFxd( fxdA, fxdB ) ((FIXED) \
 (((_int64)(fxdA) * (_int64)(fxdB)) >> 16))

/*--------------------------------------------------------------------
 * D3DMXToDegree  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491591(v=winembedded.60).html
 */
#define D3DMXToDegree( radian ) ((radian) * (180.0f / D3DMX_PI))

/*--------------------------------------------------------------------
 * D3DMXToDegreeFxd  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491105(v=winembedded.60).html
 */
#define D3DMXToDegreeFxd( radian ) \
 D3DMXMulFxd(radian, D3DMXDivFxd(D3DMXToFixed(180.0f), D3DMX_PI_FXD))

/*--------------------------------------------------------------------
 * D3DMXToFixed  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491097(v=winembedded.60).html
 */
#define D3DMXToFixed( flVal ) ((FIXED)((flVal) * 65536.0f))

/*--------------------------------------------------------------------
 * D3DMXToFloat  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee490860(v=winembedded.60).html
 */
#define D3DMXToFloat( fxdVal ) ((FLOAT)(fxdVal) / 65536.0f)

/*--------------------------------------------------------------------
 * D3DMXToRadian  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491442(v=winembedded.60).html
 */
#define D3DMXToRadian( degree ) ((degree) * (D3DMX_PI / 180.0f))

/*--------------------------------------------------------------------
 * D3DMXToRadianFxd  [macro]
 * surface: ce-only
 * library: -
 * versions: 6.0..699
 * source: corpus/learn/windows-embedded-ce-6.0/ee491286(v=winembedded.60).html
 */
#define D3DMXToRadianFxd( degree ) \
 D3DMXMulFxd(degree, D3DMXDivFxd(D3DMX_PI_FXD, D3DMXToFixed(180.0f)))
