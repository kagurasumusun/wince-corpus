/* NERR_DCNotFound | CONFLICT
 *   243  in CE 2.11..2.12, 3.0..399, 5.0..699 (5 row(s))
 *   2453  in CE 2.11..2.12, 3.0..399, 5.0..699 (5 row(s))
 * reviewed [documentation-inconsistency]: the Alphabetical
 *   Order error tables print 243, the Numerical Order tables
 *   print 2453; the numerical sequence around it is contiguous
 *   (2452 NERR_LastAdmin, 2453 NERR_DCNotFound, 2454 next) and
 *   lmerr.h of the public-domain w32api prints (NERR_BASE+353)
 *   = 2453. The alphabetical copies repeat the truncated code
 *   in every generation.
 * resolution: #define NERR_DCNotFound 2453 -- the reviewed print, one the pages themselves state
 */

#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 211 && _WIN32_WCE < 213) || (_WIN32_WCE >= 300 && _WIN32_WCE < 400) || (_WIN32_WCE >= 500 && _WIN32_WCE < 700)) /* CE 2.11..2.12, 3.0..399, 5.0..699 */
#define NERR_DCNotFound 2453
#endif /* _WIN32_WCE */

