 * reviewed [documentation-inconsistency]: the Alphabetical
 *   Order error tables print 242, the Numerical Order tables
 *   print 2452 (contiguous with 2453 NERR_DCNotFound); lmerr.h
 *   of the public-domain w32api prints (NERR_BASE+352) = 2452.
 * resolution: #define NERR_LastAdmin 2452 -- the reviewed print, one the pages themselves state
 */

#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 211 && _WIN32_WCE < 213) || (_WIN32_WCE >= 300 && _WIN32_WCE < 400) || (_WIN32_WCE >= 500 && _WIN32_WCE < 700)) /* CE 2.11..2.12, 3.0..399, 5.0..699 */
