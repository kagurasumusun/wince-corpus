typedef enum _OBEX_EVENT {
  OE_QUERY_PASSWORD = 0,
  OE_NEW_CONNECTION = OE_QUERY_PASSWORD + 1,
  OE_NEW_COMMAND = OE_NEW_CONNECTION + 1,
