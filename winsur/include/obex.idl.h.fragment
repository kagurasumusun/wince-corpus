typedef struct _OBEX_HEADER {
  byte bId;
  [switch_is(bId & OBEX_HEADER_4BYTE)]
  union {
    [case(OBEX_HEADER_UNICODE)]
    [string] LPWSTR pszData;
    [case(OBEX_HEADER_4BYTE)]
    DWORD dwData;
    [case(OBEX_HEADER_1BYTE)]
    byte bData;
    [case(OBEX_HEADER_STREAM)]
    struct {
      DWORD dwSize;
      [size_is(dwSize)] byte* pbaData;
    } ba;
  } value;
} OBEX_HEADER;
