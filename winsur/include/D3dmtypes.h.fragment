Product = HIWORD(DriverVersion.HighPart) Version = LOWORD(DriverVersion.HighPart) SubVersion = HIWORD(DriverVersion.LowPart) Build = LOWORD(DriverVersion.LowPart)
Br = min(Sa, 1–Da) Bg = min(Sa, 1–Da) Bb = min(Sa, 1–Da) Ba = 1
O = f(S,D).
F = 1/e^(d*density)2
bias = (max * D3DMRS_SLOPESCALEDEPTHBIAS) + D3DMRS_DEPTHBIAS.
HRESULT hr = pd3dmDevice->SetRenderState( dwIndex + D3DMRENDERSTATE_WRAPBIAS, D3DMWRAPCOORD_0 | D3DMWRAPCOORD_1);
Output = (1 - ARG1Alpha) * ARG2RGB + ARG1RGB
