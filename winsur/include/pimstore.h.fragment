/*--------------------------------------------------------------------
 * IException  [function]
 * surface: ce-only
 * library: Pimstore.lib
 * versions: 5.0..599
 * source: corpus/chm/windows-ce-5.0/wcepoom5/html/wce50lrfIExceptionIUnknown.html
 */
#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 500 && _WIN32_WCE < 600)) /* CE 5.0..599 */
void GetFirstExceptionItem (IAppointment *pAppt) 
{ 
 IRecurrencePattern *pRec; 
 IExceptions *pExceptions; 
 IException *pException; 
 // Get the exception item 
 pAppt->GetRecurrencePattern (&pRec); 
 pRec->get_Exceptions (&pExceptions); 
 pExceptions->Item (1, &pException); 
 // Release objects 
 pRec->Release (); 
 pExceptions->Release (); 
 pException->Release (); 
}
#endif /* _WIN32_WCE */

/*--------------------------------------------------------------------
 * IException::get_Application  [function]
 * surface: ce-only
