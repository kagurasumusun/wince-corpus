  cpVoiceToken.Release();
  if(SUCCEEDED(hr))
  hr = cpEnum->Next( 1, &cpVoiceToken, NULL );
  if(SUCCEEDED(hr))
  hr = cpVoice->SetVoice(cpVoiceToken);
  if(SUCCEEDED(hr))
  hr = cpVoice->Speak( L"How are you?", SPF_DEFAULT, NULL);
}
