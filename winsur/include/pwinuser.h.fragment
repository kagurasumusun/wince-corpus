case WM_GESTURE:
{
  HGESTUREINFO hgi = reinterpert_cast(lParam);
  If (GID_SELECT == wParam)
  {
    GESTUREINFO gi;
    gi.cbSize = sizeof(GESTUREINFO);
    if (GetGestureInfo(hgi, &gi))
    {
      ProcessSelect(*gi);
    }
    CloseGestureInfoHandle(hgi);
    return 1;
  }
  break;
}
