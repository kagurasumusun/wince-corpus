/* quoted (cell): <tr> <td width="40%"><a id="STRSAFE_FILL_BEHIND_NULL"></a><a id="strsafe_fill_behind_null"></a><dl> <dt><b>STRSAFE_FILL_BEHIND_NULL</b></dt> <dt>0x00000200</dt> </dl> </td> <td width="60%"> If the function succeeds, the low byte of <i>dwFlags</i> (0) is used to fill the uninitialized portion of <i>pszDest</i> following the terminating null character. </td> </tr>  [+27 more row(s)] */
#define STRSAFE_FILL_BEHIND_NULL 0x00000200

/* STRSAFE_FILL_ON_FAILURE 0x00000400 | win32-reference (Win32 desktop reference only -- verify against the CE SDK; 56 statement(s), e.g. corpus/win32/api/strsafe/nf-strsafe-stringcbcatexa.md) | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
/* quoted (cell): <tr> <td width="40%"><a id="STRSAFE_FILL_ON_FAILURE"></a><a id="strsafe_fill_on_failure"></a><dl> <dt><b>STRSAFE_FILL_ON_FAILURE</b></dt> <dt>0x00000400</dt> </dl> </td> <td width="60%"> If the function fails, the low byte of <i>dwFlags</i> (0) is used to fill the entire <i>pszDest</i> buffer, and the buffer is null-terminated. In the case of a <b>STRSAFE_E_INSUFFICIENT_BUFFER</b> failure, any truncated string returned is overwritten. </td> </tr>  [+27 more row(s)] */
#define STRSAFE_FILL_ON_FAILURE 0x00000400

/* STRSAFE_IGNORE_NULLS 0x00000100 | win32-reference (Win32 desktop reference only -- verify against the CE SDK; 56 statement(s), e.g. corpus/win32/api/strsafe/nf-strsafe-stringcbcatexa.md) | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
/* quoted (cell): <tr> <td width="40%"><a id="STRSAFE_IGNORE_NULLS"></a><a id="strsafe_ignore_nulls"></a><dl> <dt><b>STRSAFE_IGNORE_NULLS</b></dt> <dt>0x00000100</dt> </dl> </td> <td width="60%"> Treat <b>NULL</b> string pointers like empty strings (TEXT("")). </td> </tr>  [+27 more row(s)] */
#define STRSAFE_IGNORE_NULLS 0x00000100

/* STRSAFE_NO_TRUNCATION 0x00001000 | win32-reference (Win32 desktop reference only -- verify against the CE SDK; 56 statement(s), e.g. corpus/win32/api/strsafe/nf-strsafe-stringcbcatexa.md) | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
/* quoted (cell): <tr> <td width="40%"><a id="STRSAFE_NO_TRUNCATION"></a><a id="strsafe_no_truncation"></a><dl> <dt><b>STRSAFE_NO_TRUNCATION</b></dt> <dt>0x00001000</dt> </dl> </td> <td width="60%"> If the function fails, <i>pszDest</i> is untouched. Nothing is added to the original contents. </td> </tr>  [+27 more row(s)] */
#define STRSAFE_NO_TRUNCATION 0x00001000

/* STRSAFE_NULL_ON_FAILURE 0x00000800 | win32-reference (Win32 desktop reference only -- verify against the CE SDK; 56 statement(s), e.g. corpus/win32/api/strsafe/nf-strsafe-stringcbcatexa.md) | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
/* quoted (cell): <tr> <td width="40%"><a id="STRSAFE_NULL_ON_FAILURE"></a><a id="strsafe_null_on_failure"></a><dl> <dt><b>STRSAFE_NULL_ON_FAILURE</b></dt> <dt>0x00000800</dt> </dl> </td> <td width="60%"> If the function fails, <i>pszDest</i> is set to an empty string (TEXT("")). In the case of a <b>STRSAFE_E_INSUFFICIENT_BUFFER</b> failure, any truncated string is overwritten. </td> </tr>  [+27 more row(s)] */
