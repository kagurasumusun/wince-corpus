void SortItems (IPOutlookApp *polApp)
{
  IPOutlookItemCollection *pItems;
  IFolder *pFolder;
  polApp->GetDefaultFolder (olFolderContacts, &pFolder);
  pFolder->get_Items (&pItems);
  pItems->Sort (TEXT "[TimezoneIndex]", FALSE);
  pItems->Release ();
  pFolder->Release ();
}
