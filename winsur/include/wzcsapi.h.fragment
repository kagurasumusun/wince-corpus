/* MEDIA_STATE_CONNECTED | CONFLICT
 *   1  in CE 5.0..699 (3 row(s))
 *   0  in CE 4.0..699 (3 row(s))
 * the pages do not agree on the number -- no #define is written */

/* MEDIA_STATE_DISCONNECTED | CONFLICT
 *   0  in CE 5.0..699 (3 row(s))
 *   1  in CE 4.0..699 (3 row(s))
 * the pages do not agree on the number -- no #define is written */

/* TMMS_DEFAULT_TF | CONFLICT
 *   0x00001388  in CE 5.0..699 (2 row(s))
 *   0x0000ea60  in CE 5.0..699 (2 row(s))
 * reviewed [documentation-inconsistency]: one page prints one
 *   name twice: the WZC_CONTEXT tmTf member sentence prints
 *   'TMMS_DEFAULT_TF (0x0000ea60)' and the tmTd member sentence
 *   prints 'TMMS_DEFAULT_TF (0x00001388)' where the member name
 *   shows a td default was meant (the page lists
 *   tmTr/tmTc/tmTp/tmTf/tmTd and prints
 *   TMMS_DEFAULT_TR/TC/TP/TF beside them; no TMMS_DEFAULT_TD
 *   exists). 0x0000ea60 is the tmTf default on both the CE 5.0
 *   and CE 6.0 copies; the page itself states 'Default values
 *   are defined in Wzcsapi.h'.
 * resolution: #define TMMS_DEFAULT_TF 0x0000ea60 -- the reviewed print, one the pages themselves state
 */

#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 500 && _WIN32_WCE < 700)) /* CE 5.0..699 */
#define TMMS_DEFAULT_TF 0x0000ea60
#endif /* _WIN32_WCE */


