void main( void )
{
  int count, total = 0;
  char buffer[100];
  FILE *stream;
  if( (stream = fopen( "feof.c", "r" )) == NULL )
  exit( 1 );
  while( !feof( stream ) )
  {
    count = fread( buffer, sizeof( char ), 100, stream );
    if( ferror( stream ) ) {
      printf( "Read error" );
      break;
    }
    total += count;
  }
  printf( "Number of bytes read = %d\n", total );
  fclose( stream );
}
