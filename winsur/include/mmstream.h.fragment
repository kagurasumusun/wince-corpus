 */
#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 300 && _WIN32_WCE < 400) || (_WIN32_WCE >= 500 && _WIN32_WCE < 700))
#define COMPSTAT_NOUPDATEOK 0x01
#endif /* 3.0..399, 5.0..699 */
