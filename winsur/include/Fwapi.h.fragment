typedef struct _FIREWALL_LOG_ENTRY {
 FW_IP_ADDRESS PrivateHost;
 FW_IP_ADDRESS PublicHost;
 INT Protocol;
 FW_ACTIONS Action;
 FW_DIRECTIONS Direction;
 union
 {
 struct 
 {
 ushort tcp_src;
 ushort tcp_dest;
 int tcp_seq;
 int tcp_ack;
 ushort tcp_flags;
 ushort tcp_window;
 ushort tcp_xsum;
 ushort tcp_urgent;
 }TCPHeader;
 struct
 {
 ushort Source;
 ushort Dest; 
 ushort Length;
 ushort Checksum;
 }UDPHeader;
 struct {
 uchar ich_type;
 uchar ich_code;
 ushort ich_xsum; 
 ulong ich_param;
 }ICMPHeader;
 struct
 {
 uchar Type; 
 uchar Code;
 ushort Checksum; 
 }ICMPv6Header;
 };
}FW_LOG_ENTRY, *PFW_LOG_ENTRY;
#endif /* _WIN32_WCE */

