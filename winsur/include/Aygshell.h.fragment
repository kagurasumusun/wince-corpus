BOOL CALLBACK DlgProc(HWND hdlg, UINT msg, WPARAM wp, LPARAM lp)
{
  SHINITDLGINFO shidi;
  switch (msg)
  {
    case WM_INITDIALOG:
    shidi.dwMask = SHIDIM_FLAGS;
    shidi.hDlg = hdlg;
    shidi.dwFlags = SHIDIF_CANCELBUTTON | SHIDIF_SIZEDLG;
    SHInitDialog(&shidi);
    return TRUE;
    case WM_COMMAND:
    if (LOWORD(wp) == IDCANCEL)
    {
      EndDialog(hdlg, IDCANCEL);
    }
    return TRUE;
  }
  return FALSE;
}
SHINITDLGINFO shidi; BOOL bSuccessInit; case WM_INITDIALOG: shidi.dwMask = SHIDIM_FLAGS; shidi.dwFlags = SHIDIF_SIZEDLGFULLSCREEN; shidi.hDlg = hDlg; SHInitDialog(&shidi); bSuccessInit = SHInitDialog(&shidi); break;
