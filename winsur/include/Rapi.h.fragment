#define SM_CYDRAG 69

/* SM_CYEDGE 46 | entity-page; 1 statement(s), e.g. corpus/win32/api/winuser/nf-winuser-getsystemmetrics.md | also in: Winuser.h | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
