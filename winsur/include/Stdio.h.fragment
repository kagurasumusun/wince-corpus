FILE *stream;
void main( void )
{
  long l;
  float fp;
  char s[81];
  char c;
  stream = fopen( "fscanf.out", "w+" );
  if( stream == NULL )
  printf( "The file fscanf.out was not opened\n" );
  else
  {
    fprintf( stream, "%s %ld %f%c", "a-string",
    65000, 3.14159, 'x' );
    fseek( stream, 0L, SEEK_SET );
    fscanf( stream, "%s", s );
    fscanf( stream, "%ld", &l );
    fscanf( stream, "%f", &fp );
    fscanf( stream, "%c", &c );
    printf( "%s\n", s );
    printf( "%ld\n", l );
    printf( "%f\n", fp );
    printf( "%c\n", c );
    fclose( stream );
  }
}
