void main( void )
{
  char tokenstring[] = "15 12 14...";
  char s[81];
  char c;
  int i;
  float fp;
  sscanf( tokenstring, "%s", s );
  sscanf( tokenstring, "%c", &c );
  sscanf( tokenstring, "%d", &i );
  sscanf( tokenstring, "%f", &fp );
  printf( "String = %s\n", s );
  printf( "Character = %c\n", c );
  printf( "Integer: = %d\n", i );
  printf( "Real: = %f\n", fp );
}
