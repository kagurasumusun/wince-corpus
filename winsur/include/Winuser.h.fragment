WM_RENDERFORMAT uFormat = (UINT)wParam1;
WM_SETCURSOR hwnd = (HWND) wParam; nHittest = LOWORD (lParam); wMouseMsg = HIWORD (lParam);
WM_SETFOCUS hwndLoseFocus = (HWND) wParam;
WM_SETFONT wParam = (WPARAM) hfont;lParam = MAKELPARAM(fRedraw,0);
WM_SETICON wParam = (WPARAM)(BOOL)fType; lParam = (LPARAM)(HICON)hicon;
WM_SETREDRAW wParam = (WPARAM) fRedraw; lParam = 0;
WM_SETTEXT wParam = 0; lParam = (LPARAM)(LPCTSTR) lpsz;
WM_SETTINGCHANGE wParam = wFlag;lParam = (LPARAM)(LPCTSTR)pszSectionName;
WM_SIZE fwSizeType = wParam; nWidth = LOWORD(lParam); nHeight = HIWORD(lParam);
WM_STYLECHANGED wStyleType = wParam; lpss = (LPSTYLESTRUCT) lParam;
WM_SYSCHAR chCharCode = (TCHAR) wParam; lKeyData = lParam;
WM_SYSCOMMAND uCmdType = wParam; xPos = LOWORD(lParam); yPos = HIWORD(lParam);
WM_SYSDEADCHAR chCharCode = (TCHAR) wParam; lKeyData = lParam;
WM_SYSKEYDOWN nVirtKey = (int) wParam; lKeyData = lParam;
WM_SYSKEYUP nVirtKey = (int) wParam; lKeyData = lParam;
WM_TIMER wTimerID = wParam; tmprc = (TIMERPROC *) lParam;
WM_VKEYTOITEM vkey = LOWORD(wParam); nCaretPos = HIWORD(wParam); hwndLB = lParam;
case WM_VSCROLL:
{
  int nScrollCode = (int)LOWORD(wParam);
  int nPos = (short int)HIWORD(wParam);
  SCROLLINFO si = {sizeof(SCROLLINFO),
  SIF_PAGE|SIF_POS|SIF_RANGE|SIF_TRACKPOS, 0, 0, 0, 0,
  0};
  GetScrollInfo (hWnd, SB_VERT, &si);
  int nNewPos = si.nPos;
  switch (nScrollCode)
  {
    case SB_THUMBPOSITION:
    nNewPos = nPos + si.nMin;
    break;
  }
  si.fMask = SIF_POS;
  si.nPos = nNewPos;
  SetScrollInfo (hWnd, SB_VERT, &si, TRUE);
}
return TRUE;
WM_WINDOWPOSCHANGED lpwp = (LPWINDOWPOS) lParam;
