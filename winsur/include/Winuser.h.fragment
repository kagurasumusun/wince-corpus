#define SM_CXVIRTUALSCREEN 78

/* SM_CXVSCROLL 2 | entity-page; 2 statement(s), e.g. corpus/win32/api/winuser/nf-winuser-getsystemmetrics.md | also in: Rapi.h | value printed only by the Win32 shared reference (a CE page documents the name; verify the number against the CE SDK) */
