 * functions and callbacks
 * ================================================================ */

#if defined(_WIN32_WCE) && ((_WIN32_WCE >= 400 && _WIN32_WCE < 500)) /* CE 4.0..499 */

/*--------------------------------------------------------------------
 * D3DCOLOR_ARGB  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms885124(v=msdn.10).html
 */
D3DCOLOR_ARGB(a,r,g,b) \
((D3DCOLOR)((((a)&0xff)<<24)|(((r)&0xff)<<16)|(((g)&0xff)<<8)|((b)&0xff)))

/*--------------------------------------------------------------------
 * D3DCOLOR_COLORVALUE  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms885230(v=msdn.10).html
 */
D3DCOLOR_COLORVALUE(r,g,b,a) \
D3DCOLOR_RGBA((DWORD)((r)*255.f),(DWORD)((g)*255.f),(DWORD)((b)*255.f),(D
ORD)((a)*255.f)
)

/*--------------------------------------------------------------------
 * D3DCOLOR_RGBA  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms885239(v=msdn.10).html
 */
D3DCOLOR_RGBA(r,g,b,a) D3DCOLOR_ARGB(a,r,g,b)

/*--------------------------------------------------------------------
 * D3DCOLOR_XRGB  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms885243(v=msdn.10).html
 */
D3DCOLOR_XRGB(r,g,b) D3DCOLOR_ARGB(0xff,r,g,b)

/*--------------------------------------------------------------------
 * D3DTS_WORLD  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms887143(v=msdn.10).html
 */
D3DTS_WORLD D3DTS_WORLDMATRIX(0)

/*--------------------------------------------------------------------
 * D3DTS_WORLDMATRIX  [function]
 * surface: ce-only
 * library: -
 * versions: 4.0..499
 * source: corpus/learn/windows-ce-net-4x/ms887258(v=msdn.10).html
 */
D3DTS_WORLDMATRIX(index) (D3DTRANSFORMSTATETYPE)(index + 256)

/*--------------------------------------------------------------------
 * D3DTS_WORLDn  [function]
