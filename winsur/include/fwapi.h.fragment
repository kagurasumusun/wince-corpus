 ushort tcp_xsum;
 ushort tcp_urgent;
 }TCPHeader;
 struct
 {
 ushort Source;
 ushort Dest; 
 ushort Length;
 ushort Checksum;
 }UDPHeader;
 struct {
 uchar ich_type;
 uchar ich_code;
 ushort ich_xsum; 
 ulong ich_param;
 }ICMPHeader;
