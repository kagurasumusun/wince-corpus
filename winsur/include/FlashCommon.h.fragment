/* FLASH_FLAG_NOR = 0x00000002  [unified-kb] */
#define FLASH_FLAG_NOR 0x00000002

/* FLASH_FLAG_REQUIRE_SEQ_PAGE_PROGRAM = 0x00000004  [unified-kb] */
