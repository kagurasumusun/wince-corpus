/* KD_IOCTL_ENUM_CBP
 * row: KD_IOCTL_ENUM_CBP 0x00000004 Enumerates the code breakpoints that are set. The ulCount member of KD_BPINFO is incremented from 0 to n, where n is the number of available breakpoints.
 * source: corpus/learn/windows-ce-5.0/ms904919(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define KD_IOCTL_ENUM_CBP 0x00000004

/* KD_IOCTL_ENUM_DBP
 * row: KD_IOCTL_ENUM_DBP 0x00000013 Enumerates the data breakpoints that are set. The ulCount parameter is incremented from 0 to n, where n is the number of available breakpoints.
 * source: corpus/learn/windows-ce-5.0/ms904919(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define KD_IOCTL_ENUM_DBP 0x00000013

