/* Pkfuncs.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* KD_IOCTL_CLEAR_CBP
 * row: KD_IOCTL_CLEAR_CBP 0x00000002 Clears a code breakpoint. The OEM sets the ulHandle member of KD_BPINFO to the handle of the breakpoint to be cleared.
 * source: corpus/learn/windows-ce-5.0/ms904919(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define KD_IOCTL_CLEAR_CBP 0x00000002

/* KD_IOCTL_CLEAR_DBP
 * row: KD_IOCTL_CLEAR_DBP 0x00000011 Clears a data breakpoint. The OEM sets the ulHandle member of KD_BPINFO to the handle of the breakpoint to be cleared.
 * source: corpus/learn/windows-ce-5.0/ms904919(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define KD_IOCTL_CLEAR_DBP 0x00000011

