/* KD_IOCTL_SET_CBP
 * row: KD_IOCTL_SET_CBP 0x00000001 Sets a code breakpoint. The ulAddress member of the KD_BPINFO structure is set to the address to write the breakpoint. The OEM sets the ulHandle member to the handle of the breakpoint.
 * source: corpus/learn/windows-ce-5.0/ms904919(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define KD_IOCTL_SET_CBP 0x00000001

