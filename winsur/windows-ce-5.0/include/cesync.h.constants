/* cesync.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* RSF_AUTO_COMBINE
 * row: RSF_AUTO_COMBINE 0x00000200 An object is being written to the desktop computer, and there are no items on the desktop computer to combine with the object.
 * source: corpus/learn/windows-ce-5.0/aa514454(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define RSF_AUTO_COMBINE 0x00000200

/* RSF_COMBINE
 * row: RSF_COMBINE 0x00000008 An object is being written to the desktop computer, and there are objects on the desktop computer to combine with the object.
 * source: corpus/learn/windows-ce-5.0/aa514454(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define RSF_COMBINE 0x00000008

