/* cecertmod.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* CERT_REVOKED
 * row: CERT_REVOKED 0x00000001 The file is digitally signed, but its certificate is registered in the Revoked List.
 * source: corpus/learn/windows-embedded-ce-6.0/ee498571(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CERT_REVOKED 0x00000001

/* CERT_STORE_UNKNOWN
 * row: CERT_STORE_UNKNOWN 0x00000002 The file is digitally signed, but its certificate is not registered in one of the certificate stores.
 * source: corpus/learn/windows-embedded-ce-6.0/ee498571(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CERT_STORE_UNKNOWN 0x00000002

/* CERT_STORE_VALID
 * row: CERT_STORE_VALID 0x00000004 The file is digitally signed, and its certificate is registered in one of the certificate stores.
 * source: corpus/learn/windows-embedded-ce-6.0/ee498571(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CERT_STORE_VALID 0x00000004

/* CERT_UNKNOWN
 * row: CERT_UNKNOWN 0x00000000 The file is not digitally signed.
 * source: corpus/learn/windows-embedded-ce-6.0/ee498571(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CERT_UNKNOWN 0x00000000
