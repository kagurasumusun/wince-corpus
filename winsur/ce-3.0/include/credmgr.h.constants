/* credmgr.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* CRED_FLAGS_PROMPT_NOW
 * row: CRED_FLAGS_PROMPT_NOW (2) If set, only the user name is saved; the credential BLOB (password) has not been written into the structure. NetUI writes the credential with this flag set, assuming the domain password will not be written until the user is prompted for it.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_FLAGS_PROMPT_NOW 2

/* CRED_PERSIST_LOCAL_MACHINE
 * row: CRED_PERSIST_LOCAL_MACHINE (2) This credential persists for all subsequent logon sessions on this machine. It is visible to other logon session of this user on this machine. It is not visible to logon sessions of this user on other machines.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_PERSIST_LOCAL_MACHINE 2

/* CRED_PERSIST_SESSION
 * row: CRED_PERSIST_SESSION (1) This credential persists only for the current logon session. It is not visible to other logon sessions of the same user. It is discarded when the user logs off.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_PERSIST_SESSION 1

/* CRED_TYPE_DOMAIN_CERTIFICATE
 * row: CRED_TYPE_DOMAIN_CERTIFICATE (3) A certificate credential specific to Microsoft authentication packages. It is a hash of the contents of a certificate in the local certificate store.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_TYPE_DOMAIN_CERTIFICATE 3

/* CRED_TYPE_DOMAIN_PASSWORD
 * row: CRED_TYPE_DOMAIN_PASSWORD (2) Network user name and password.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_TYPE_DOMAIN_PASSWORD 2

/* CRED_TYPE_DOMAIN_VISIBLE_PASSWORD
 * row: CRED_TYPE_DOMAIN_VISIBLE_PASSWORD (4) A plaintext password, such as those used by Passport and RAS.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define CRED_TYPE_DOMAIN_VISIBLE_PASSWORD 4

/* CRED_TYPE_GENERIC
 * row: CRED_TYPE_GENERIC (1) Stored as an opaque BLOB, but it has no identifying characteristics.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497996(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
