/* Blcommon.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* BL_DOWNLOAD
 * row: BL_DOWNLOAD = 0 Download the OS image from the host machine.
 * source: corpus/learn/windows-ce-5.0/ms904931(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * row: BL_DOWNLOAD = 0 Download the OS image from the host machine.
 * source: corpus/learn/windows-ce-net-4x/ms903238(v=msdn.10).html  borrowed from learn/windows-ce-net-4x
 * derived: the #define keyword is not on the page
 */
#define BL_DOWNLOAD 0

/* BL_ERROR
 * row: BL_ERROR = -1 Image download is unsuccessful.
 * source: corpus/learn/windows-ce-5.0/ms904931(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * row: BL_ERROR = -1 Image download is unsuccessful.
 * source: corpus/learn/windows-ce-net-4x/ms903238(v=msdn.10).html  borrowed from learn/windows-ce-net-4x
 * derived: the #define keyword is not on the page
 */
#define BL_ERROR -1

/* BL_JUMP
 * row: BL_JUMP = 1 Skip the download and jump to a resident OS image.
 * source: corpus/learn/windows-ce-5.0/ms904931(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * row: BL_JUMP = 1 Skip the download and jump to a resident OS image.
 * source: corpus/learn/windows-ce-net-4x/ms903238(v=msdn.10).html  borrowed from learn/windows-ce-net-4x
 * derived: the #define keyword is not on the page
 */
#define BL_JUMP 1
