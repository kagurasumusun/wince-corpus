/* Ethdbg.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* EDBG_BOOTLOAD_FORCE_DOWNLOAD
 * row: EDBG_BOOTLOAD_FORCE_DOWNLOAD 0x0001 Forces Eshell.exe to download a new image, regardless of the user's settings in the Options menu. Useful if a bootloader determines that the image currently loaded into flash is not present or is corrupt, for example.
 * source: corpus/chm/windows-ce-3.0/_wcepb_EDBG_BOOTME_DATA.html
 * derived: the #define keyword is not on the page
 */
#define EDBG_BOOTLOAD_FORCE_DOWNLOAD 0x0001

/* EDBG_CURRENT_BOOTME_VERSION
 * row: EDBG_CURRENT_BOOTME_VERSION 2 Sets the current BOOTME version. This value must be 2 or higher.
 * source: corpus/chm/windows-ce-3.0/_wcepb_EDBG_BOOTME_DATA.html
 * derived: the #define keyword is not on the page
 */
#define EDBG_CURRENT_BOOTME_VERSION 2
