/* Rndismini.h -- numbers documented for chm/windows-ce-3.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* REQ_ID_DISABLE_INT
 * row: REQ_ID_DISABLE_INT 0x00000004 SET:: Disable Interrupt
 * source: corpus/learn/windows-ce-5.0/ms920646(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * derived: the #define keyword is not on the page
 */
#define REQ_ID_DISABLE_INT 0x00000004

/* REQ_ID_ENABLE_INT
 * row: REQ_ID_ENABLE_INT 0x00000003 SET:: Enable Interrupt
 * source: corpus/learn/windows-ce-5.0/ms920646(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * derived: the #define keyword is not on the page
 */
#define REQ_ID_ENABLE_INT 0x00000003

/* REQ_ID_HARD_RESET
 * row: REQ_ID_HARD_RESET 0x00000001 SET:: Hard reset
 * source: corpus/learn/windows-ce-5.0/ms920646(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * derived: the #define keyword is not on the page
 */
#define REQ_ID_HARD_RESET 0x00000001

/* REQ_ID_SOFT_RESET
 * row: REQ_ID_SOFT_RESET 0x00000002 SET:: Soft reset
 * source: corpus/learn/windows-ce-5.0/ms920646(v=msdn.10).html  borrowed from learn/windows-ce-5.0
 * derived: the #define keyword is not on the page
 */
#define REQ_ID_SOFT_RESET 0x00000002
