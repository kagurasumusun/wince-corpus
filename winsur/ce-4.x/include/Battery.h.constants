/* Battery.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* FALSE
 * row: FALSE (0) Indicates that the batteries have not been changed.
 * source: corpus/chm/windows-ce-3.0/wceddkBATTERY_STATUS.html  borrowed from chm/windows-ce-3.0
 * derived: the #define keyword is not on the page
 */
#define FALSE 0

/* TRUE
 * row: TRUE (1) Indicates that the batteries have been changed since the last time the BatteryDrvrGetStatus function was called.
 * source: corpus/chm/windows-ce-3.0/wceddkBATTERY_STATUS.html  borrowed from chm/windows-ce-3.0
 * derived: the #define keyword is not on the page
 */
#define TRUE 1
