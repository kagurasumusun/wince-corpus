/* kfuncs.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* OEM_CERTIFY_RUN
 * row: OEM_CERTIFY_RUN (1) The OEM trusts the module to run, but restricts the module from making certain function calls.
 * source: corpus/learn/windows-embedded-ce-6.0/ee482766(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define OEM_CERTIFY_RUN 1

/* OEM_CERTIFY_TRUST
 * row: OEM_CERTIFY_TRUST (2) The OEM trusts the module to perform any OS function calls.
 * source: corpus/learn/windows-embedded-ce-6.0/ee482766(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define OEM_CERTIFY_TRUST 2
