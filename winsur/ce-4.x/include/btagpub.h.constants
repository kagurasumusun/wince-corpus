/* btagpub.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* NETWORK_FLAGS_DROP_ACTIVE
 * row: NETWORK_FLAGS_DROP_ACTIVE (0x01) Specifes that the active call must be terminated.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495838(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_DROP_ACTIVE 0x01

/* NETWORK_FLAGS_DROP_ALL
 * row: NETWORK_FLAGS_DROP_ALL (0x0f) Specifies that all calls must be terminated.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495838(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_DROP_ALL 0x0f

/* NETWORK_FLAGS_DROP_HOLD
 * row: NETWORK_FLAGS_DROP_HOLD (0x02) Specifies that a call that is on hold must be terminated.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495838(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_DROP_HOLD 0x02

/* NETWORK_FLAGS_DROP_OFFERING
 * row: NETWORK_FLAGS_DROP_OFFERING (0x04) Specifies that an incoming call must be terminated.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495838(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_DROP_OFFERING 0x04

/* NETWORK_FLAGS_DROP_OUTGOING
 * row: NETWORK_FLAGS_DROP_OUTGOING (0x08) Specifies that the outcoming call must be terminated.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495838(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_DROP_OUTGOING 0x08

/* NETWORK_FLAGS_STATE_ACTIVE
 * row: NETWORK_FLAGS_STATE_ACTIVE (0x01) Indicates an active call.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495859(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_STATE_ACTIVE 0x01

/* NETWORK_FLAGS_STATE_HOLD
 * row: NETWORK_FLAGS_STATE_HOLD (0x02) Indicates a call that is on hold.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495859(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_STATE_HOLD 0x02

/* NETWORK_FLAGS_STATE_OFFERING
 * row: NETWORK_FLAGS_STATE_OFFERING (0x04) Indicates an incoming call.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495859(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define NETWORK_FLAGS_STATE_OFFERING 0x04

/* NETWORK_FLAGS_STATE_OUTGOING
 * row: NETWORK_FLAGS_STATE_OUTGOING (0x08) Indicates an outgoing call.
 * source: corpus/learn/windows-embedded-ce-6.0/ee495859(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
