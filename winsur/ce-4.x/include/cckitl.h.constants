/* cckitl.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* KITL_FL_CLEANBOOT
 * row: KITL_FL_CLEANBOOT = 0x08 Forces a clean boot.
 * source: corpus/learn/windows-embedded-ce-6.0/ee480478(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define KITL_FL_CLEANBOOT 0x08

/* KITL_FL_DBGMSG
 * row: KITL_FL_DBGMSG= 0x01 Indicates the debug message service.
 * source: corpus/learn/windows-embedded-ce-6.0/ee480478(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define KITL_FL_DBGMSG 0x01

/* KITL_FL_KDBG
 * row: KITL_FL_KDBG = 0x04 Indicates the kernel debugger service.
 * source: corpus/learn/windows-embedded-ce-6.0/ee480478(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define KITL_FL_KDBG 0x04

/* KITL_FL_PPSH
 * row: KITL_FL_PPSH = 0x02 Indicates the target control service.
 * source: corpus/learn/windows-embedded-ce-6.0/ee480478(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define KITL_FL_PPSH 0x02
