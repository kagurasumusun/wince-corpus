/* simmgr.h -- numbers documented for learn/windows-embedded-ce-6.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* SIM_RECORDTYPE_CYCLIC
 * row: SIM_RECORDTYPE_CYCLIC 0x00000002 A cyclic set of records, each of the same length.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_CYCLIC 0x00000002

/* SIM_RECORDTYPE_DEDICATED
 * row: SIM_RECORDTYPE_DEDICATED 0x00000005 Effectively, a directory record that is a parent of other records.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_DEDICATED 0x00000005

/* SIM_RECORDTYPE_LINEAR
 * row: SIM_RECORDTYPE_LINEAR 0x00000003 A linear set of records, each of the same length.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_LINEAR 0x00000003

/* SIM_RECORDTYPE_MASTER
 * row: SIM_RECORDTYPE_MASTER 0x00000004 Every SIM has a single master record, effectively the head node.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_MASTER 0x00000004

/* SIM_RECORDTYPE_TRANSPARENT
 * row: SIM_RECORDTYPE_TRANSPARENT 0x00000001 A single variable-length record.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_TRANSPARENT 0x00000001

/* SIM_RECORDTYPE_UNKNOWN
 * row: SIM_RECORDTYPE_UNKNOWN 0x00000000 An unknown record type.
 * source: corpus/learn/windows-embedded-ce-6.0/ee496869(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define SIM_RECORDTYPE_UNKNOWN 0x00000000
