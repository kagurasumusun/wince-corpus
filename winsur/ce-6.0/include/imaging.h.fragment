/*--------------------------------------------------------------------
 * MAKEARGB  [macro]
 * library: -
 * source: corpus/learn/windows-embedded-ce-6.0/ee490465(v=winembedded.60).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define ALPHA_SHIFT 24
#define RED_SHIFT 16
#define GREEN_SHIFT 8
#define BLUE_SHIFT 0
#define ALPHA_MASK ((ARGB) 0xff << ALPHA_SHIFT)
#define MAKEARGB(a, r, g, b) \
 (((ARGB) ((a) & 0xff) << ALPHA_SHIFT)| \
 ((ARGB) ((r) & 0xff) << RED_SHIFT) | \
 ((ARGB) ((g) & 0xff) << GREEN_SHIFT)| \
 ((ARGB) ((b) & 0xff) << BLUE_SHIFT))

