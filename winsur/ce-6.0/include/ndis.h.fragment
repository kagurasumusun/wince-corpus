/*--------------------------------------------------------------------
 * TR_COMPARE_NETWORK_ADDRESSES  [macro, function]
 * library: -
 * source: corpus/learn/windows-embedded-ce-6.0/ee486726(v=winembedded.60).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_COMPARE_NETWORK_ADDRESSES(_A, _B, _Result) \
{ \
 if (*(ULONG UNALIGNED *)&(_A)[2] > \
 *(ULONG UNALIGNED *)&(_B)[2]) \
 { \
 *(_Result) = 1; \
 } \
 else if (*(ULONG UNALIGNED *)&(_A)[2] < \
 *(ULONG UNALIGNED *)&(_B)[2]) \
 { \
 *(_Result) = (UINT)-1; \
 } \
 else if (*(USHORT UNALIGNED *)(_A) > \
 *(USHORT UNALIGNED *)(_B)) \
 { \
 *(_Result) = 1; \
 } \
 else if (*(USHORT UNALIGNED *)(_A) < \
 *(USHORT UNALIGNED *)(_B)) \
 { \
 *(_Result) = (UINT)-1; \
 } \
 else \
 { \
 *(_Result) = 0; \
 } \
}

