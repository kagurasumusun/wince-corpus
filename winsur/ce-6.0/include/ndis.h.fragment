/*--------------------------------------------------------------------
 * TR_IS_NOT_DIRECTED  [macro, function]
 * library: -
 * source: corpus/learn/windows-embedded-ce-6.0/ee486486(v=winembedded.60).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_IS_NOT_DIRECTED(_Address, _Result) \
{ \
 *(_Result) = (BOOLEAN)((_Address)[0] & 0x80); \
}

