 ZAFLAGS_INCLUDE_PROXY_OVERRIDE = 0x00000008,
 ZAFLAGS_INCLUDE_INTRANET_SITES = 0x00000010,
 ZAFLAGS_NO_UI = 0x00000020,
 ZAFLAGS_SUPPORTS_VERIFICATION = 0x00000040,
 ZAFLAGS_UNC_AS_INTRANET = 0x00000080
} ZAFLAGS;

