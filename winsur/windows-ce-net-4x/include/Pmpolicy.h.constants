/* Pmpolicy.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* PPN_APPBUTTONPRESSED
 * row: PPN_APPBUTTONPRESSED 0x0006 Reserved. Set dwData to zero (0).
 * source: corpus/learn/windows-ce-5.0/ms919677(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define PPN_APPBUTTONPRESSED 0x0006

/* PPN_POWERCHANGE
 * row: PPN_POWERCHANGE 0x0002 Reserved. Set dwData to zero (0).
 * source: corpus/learn/windows-ce-5.0/ms919677(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define PPN_POWERCHANGE 0x0002

