/* Wzcsapi.h;Wzcapi.h -- numbers documented for learn/windows-ce-net-4x
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* INTFCAP_MAX_CIPHER_MASK
 * row: INTFCAP_MAX_CIPHER_MASK (0x000000ff) Bitmask value for the maximum supported cipher. INTFCAP_MAX_CIPHER_MASK & dwCapabilities result in a value of the type NDIS_802_11_WEP_STATUS.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCAP_MAX_CIPHER_MASK 0x000000ff

/* INTFCAP_SSN
 * row: INTFCAP_SSN (0x00000100) Indicates whether or not the NIC driver supports Wireless Protected Access.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCAP_SSN 0x00000100

/* INTFCTL_8021XSUPP
 * row: INTFCTL_8021XSUPP (0x1000) Indicates whether or not 802.1x support is enabled.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCTL_8021XSUPP 0x1000

/* INTFCTL_CM_MASK
 * row: INTFCTL_CM_MASK (0x0007) Bitmask for the network filter mode. INTFCTL_CM_MASK & dwCtlFlags result in a value of the type NDIS_802_11_NETWORK_INFRASTRUCTURE. The resulting value indicates whether WZCSVC connects only to infrastructure networks, adhoc networks, or to both types of networks.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCTL_CM_MASK 0x0007

/* INTFCTL_ENABLED
 * row: INTFCTL_ENABLED (0x8000) Indicates whether or not WZCSVC should configure the interface.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCTL_ENABLED 0x8000

/* INTFCTL_FALLBACK
 * row: INTFCTL_FALLBACK (0x4000) If a preferred network is not available, this value indicates whether WZCSVC should automatically configure the NIC to associate to any available network.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCTL_FALLBACK 0x4000

/* INTFCTL_OIDSSUPP
 * row: INTFCTL_OIDSSUPP (0x2000) Indicates whether or not the NIC driver supports all the OIDs required by WZCSVC to function.
