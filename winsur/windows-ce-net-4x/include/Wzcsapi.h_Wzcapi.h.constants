 * derived: the #define keyword is not on the page
 */
#define INTFCTL_OIDSSUPP 0x2000

/* INTFCTL_POLICY
 * row: INTFCTL_POLICY (0x0800) Indicates whether or not the control flags for this interface are pushed by a group policy.
 * source: corpus/learn/windows-ce-5.0/aa448306(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define INTFCTL_POLICY 0x0800

