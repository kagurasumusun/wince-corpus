 * source: corpus/learn/windows-ce-net-4x/ms907135(v=msdn.10).html  borrowed from learn
 * derived: the #define keyword is not on the page
 */
#define LINEADDRCAPFLAGS_NOEXTERNALCALLS 0x10000000

