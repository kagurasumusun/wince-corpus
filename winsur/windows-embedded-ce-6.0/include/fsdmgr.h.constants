/* fsdmgr.h -- numbers documented for learn/windows-embedded-ce-6.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* FSD_FLAG_LOCKFILE_SUPPORTED
 * row: FSD_FLAG_LOCKFILE_SUPPORTED 0x8 The FSD supports the MyFSD_LockFileEx and the MyFSD_UnLockFileEx functions.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489745(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define FSD_FLAG_LOCKFILE_SUPPORTED 0x8

/* FSD_FLAG_NETWORK
 * row: FSD_FLAG_NETWORK 0x10 The FSD is a network file system.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489745(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define FSD_FLAG_NETWORK 0x10

/* FSD_FLAG_TRANSACT_WRITES
 * row: FSD_FLAG_TRANSACT_WRITES 0x2 The volume supports transaction-safe WriteFile operations. This indicates that the file system metadata is not corrupted by a power loss.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489745(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define FSD_FLAG_TRANSACT_WRITES 0x2

/* FSD_FLAG_TRANSACTION_SAFE
 * row: FSD_FLAG_TRANSACTION_SAFE 0x1 The volume supports transaction safe operations. This indicates that the file system meta-data is not corrupted by a power loss.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489745(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define FSD_FLAG_TRANSACTION_SAFE 0x1

/* FSD_FLAG_WFSC_SUPPORTED
 * row: FSD_FLAG_WFSC_SUPPORTED 0x4 The FSD supports the MyFSD_WriteFileGather and the MyFSD_ReadFileScatter functions.
 * source: corpus/learn/windows-embedded-ce-6.0/ee489745(v=winembedded.60).html
 * derived: the #define keyword is not on the page
 */
#define FSD_FLAG_WFSC_SUPPORTED 0x4
