/*--------------------------------------------------------------------
 * TR_COMPARE_NETWORK_ADDRESSES  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448219(v=msdn.10).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_COMPARE_NETWORK_ADDRESSES(_A, _B, _Result) \
{ \
 if (*(ULONG UNALIGNED *)&(_A)[2] > \
 *(ULONG UNALIGNED *)&(_B)[2]) \
 { \
 *(_Result) = 1; \
 } \
 else if (*(ULONG UNALIGNED *)&(_A)[2] < \
 *(ULONG UNALIGNED *)&(_B)[2]) \
 { \
 *(_Result) = (UINT)-1; \
 } \
 else if (*(USHORT UNALIGNED *)(_A) > \
 *(USHORT UNALIGNED *)(_B)) \
 { \
 *(_Result) = 1; \
 } \
 else if (*(USHORT UNALIGNED *)(_A) < \
 *(USHORT UNALIGNED *)(_B)) \
 { \
 *(_Result) = (UINT)-1; \
 } \
 else \
 { \
 *(_Result) = 0; \
 } \
}

/*--------------------------------------------------------------------
 * TR_COPY_NETWORK_ADDRESS  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448220(v=msdn.10).html
 */
#define TR_COPY_NETWORK_ADDRESS(_D, _S) \
{ \
 *((ULONG UNALIGNED *)(_D)) = *((ULONG UNALIGNED *)(_S)); \
 *((USHORT UNALIGNED *)((UCHAR *)(_D)+4)) = \
 *((USHORT UNALIGNED *)((UCHAR *)(_S)+4)); \
}

/*--------------------------------------------------------------------
 * TR_IS_BROADCAST  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448221(v=msdn.10).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_IS_BROADCAST(_Address, _Result) \
{ \
 *(_Result) = (BOOLEAN)(((*(UNALIGNED USHORT *)&(_Address)[0] == 0xFFFF) || \
 (*(UNALIGNED USHORT *)&(_Address)[0] == 0x00C0)) && \
 (*(UNALIGNED ULONG *)&(_Address)[2] == 0xFFFFFFFF));\
}

/*--------------------------------------------------------------------
 * TR_IS_FUNCTIONAL  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448223(v=msdn.10).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_IS_FUNCTIONAL(_Address, _Result) \
{ \
 *(_Result) = (BOOLEAN)(((_Address)[0] & 0x80) && \
 !((_Address)[2] & 0x80)); \
}

/*--------------------------------------------------------------------
 * TR_IS_GROUP  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448224(v=msdn.10).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_IS_GROUP(_Address, _Result) \
{ \
 *(_Result) = (BOOLEAN)((_Address)[0] & (_Address)[2] & 0x80); \
}

/*--------------------------------------------------------------------
 * TR_IS_NOT_DIRECTED  [macro, function]
 * library: -
 * source: corpus/learn/windows-ce-5.0/aa448225(v=msdn.10).html
 * NOTE: the page lost the spaces in this declaration (spacing: collapsed) -- prefer another page's copy
 */
#define TR_IS_NOT_DIRECTED(_Address, _Result) \
{ \
 *(_Result) = (BOOLEAN)((_Address)[0] & 0x80); \
}

/*--------------------------------------------------------------------
 * TR_IS_SOURCE_ROUTING  [macro, function]
