/* Lt2pcfg.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* L2TP_IPSEC_AUTH_PRESHAREDKEY
 * row: L2TP_IPSEC_AUTH_PRESHAREDKEY = 0x2 Enables pre-shared key authentication.
 * source: corpus/learn/windows-ce-5.0/ms893321(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define L2TP_IPSEC_AUTH_PRESHAREDKEY 0x2

/* L2TP_IPSEC_AUTH_SIGNATURE
 * row: L2TP_IPSEC_AUTH_SIGNATURE = 0x1 Enables signature-based authentication.
 * source: corpus/learn/windows-ce-5.0/ms893321(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define L2TP_IPSEC_AUTH_SIGNATURE 0x1
