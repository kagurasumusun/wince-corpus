/* Winbase.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* DEVFLAGS_BOOTPHASE_1
 * row: DEVFLAGS_BOOTPHASE_1 0x00001000 Driver is loaded during boot phase one. By default, device drivers are loaded during boot phase two. Boot phase zero is before the Device Manager loads. Boot phase one is to find the registry. Boot phase two is when initial device drivers load. Boot phase three is after initial device drivers load.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_BOOTPHASE_1 0x00001000

/* DEVFLAGS_IRQ_EXCLUSIVE
 * row: DEVFLAGS_IRQ_EXCLUSIVE 0x00000100 Driver loads only when it has exclusive access to the IRQ.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_IRQ_EXCLUSIVE 0x00000100

/* DEVFLAGS_LOADLIBRARY
 * row: DEVFLAGS_LOADLIBRARY 0x00000002 Driver is loaded with LoadLibrary instead of LoadDriver.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_LOADLIBRARY 0x00000002

/* DEVFLAGS_NAKEDENTRIES
 * row: DEVFLAGS_NAKEDENTRIES 0x00000008 Driver entry points do not have a XXXPrefix prepended.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_NAKEDENTRIES 0x00000008

/* DEVFLAGS_NOLOAD
 * row: DEVFLAGS_NOLOAD 0x00000004 Driver is not loaded.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_NOLOAD 0x00000004

/* DEVFLAGS_NONE
 * row: DEVFLAGS_NONE 0x00000000 No flags are defined.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_NONE 0x00000000

/* DEVFLAGS_TRUSTEDCALLERONLY
 * row: DEVFLAGS_TRUSTEDCALLERONLY 0x00010000 Driver can only be opened by a trusted application.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_TRUSTEDCALLERONLY 0x00010000

/* DEVFLAGS_UNLOAD
 * row: DEVFLAGS_UNLOAD 0x00000001 Driver unloads after a call to the XXX_Init entry point or after the XXX_Init entry point returns. No error code is returned. Bus Enumerator typically runs with this flag.
 * source: corpus/learn/windows-ce-5.0/ms896107(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define DEVFLAGS_UNLOAD 0x00000001

