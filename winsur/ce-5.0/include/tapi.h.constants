/* tapi.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* LINEDISCONNECTMODE_DESTINATIONBARRED
 * row: LINEDISCONNECTMODE_DESTINATIONBARRED = 0x00100000 The call failed because call barring was enabled.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497063(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define LINEDISCONNECTMODE_DESTINATIONBARRED 0x00100000

/* LINEDISCONNECTMODE_FDNRESTRICT
 * row: LINEDISCONNECTMODE_FDNRESTRICT = 0x00200000 The call failed because the FDN list indicated that the number was not allowed.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497063(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define LINEDISCONNECTMODE_FDNRESTRICT 0x00200000

/* LINEDISCONNECTMODE_SIMCALLBLOCKED
 * row: LINEDISCONNECTMODE_SIMCALLBLOCKED = 0x00400000 The SIM blocked the call.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497063(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define LINEDISCONNECTMODE_SIMCALLBLOCKED 0x00400000

/* LINEDISCONNECTMODE_SIMCALLMODIFIED
 * row: LINEDISCONNECTMODE_SIMCALLMODIFIED = 0x00800000 The SIM replaced the call with an unstructured supplementary services data (USSD) service.
 * source: corpus/learn/windows-embedded-ce-6.0/ee497063(v=winembedded.60).html  borrowed from learn/windows-embedded-ce-6.0
 * derived: the #define keyword is not on the page
 */
#define LINEDISCONNECTMODE_SIMCALLMODIFIED 0x00800000
