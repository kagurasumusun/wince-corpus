/* Winuser.h -- numbers documented for learn/windows-ce-5.0
 *
 * Each block quotes a table row a page prints (name and value in
 * separate columns).  The #define line below a block is derived
 * from that row: the page did not print a #define, so the keyword
 * is marked as derived and a row whose pages disagree on the
 * number is not turned into one.
 */

/* KBDI_KEYBOARD_ALPHA_NUM
 * row: KBDI_KEYBOARD_ALPHA_NUM 0x0008 Indicates whether or not the keyboard hardware has alphanumeric keys.
 * source: corpus/learn/windows-ce-5.0/ms929253(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define KBDI_KEYBOARD_ALPHA_NUM 0x0008

/* KBDI_KEYBOARD_ENABLED
 * row: KBDI_KEYBOARD_ENABLED 0x0002 Indicates whether or not the keyboard hardware is enabled. This bit is assumed to be set but can be modified with EnableHardwareKeyboard.
 * source: corpus/learn/windows-ce-5.0/ms929253(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define KBDI_KEYBOARD_ENABLED 0x0002

/* KBDI_KEYBOARD_ENTER_ESC
 * row: KBDI_KEYBOARD_ENTER_ESC 0x0004 Indicates whether or not the keyboard hardware has ENTER and ESC keys.
 * source: corpus/learn/windows-ce-5.0/ms929253(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define KBDI_KEYBOARD_ENTER_ESC 0x0004

/* KBDI_KEYBOARD_PRESENT
 * row: KBDI_KEYBOARD_PRESENT 0x0001 Indicates whether or not the system has keyboard hardware.
 * source: corpus/learn/windows-ce-5.0/ms929253(v=msdn.10).html
 * derived: the #define keyword is not on the page
 */
#define KBDI_KEYBOARD_PRESENT 0x0001
