# Harvest logs (recreated by tools/harvest.py)
*.log

# Python
__pycache__/

# Upstream download cache (tools/fetch-upstream.py --cache-dir)
.cache/

# SQLite databases are derived caches and are not committed:
# kb/kb.sqlite3 (~570 MB) exceeds GitHub's 100 MiB file limit and is
# published as a release asset instead (kb/manifest.json, committed,
# pins its hash; the build is deterministic), and
# data/index/corpus.sqlite3 outgrew the same limit in the 2026-10
# mass harvest (76 MB committed at 127k pages, over 100 MiB at
# 173k) -- every workflow that reads it builds it first with
# tools/build-index-sql.py.
*.sqlite3*

# Scratch build output.  Nothing generated here is committed: the
# include/.def generator (a separate layer on top of kb/, not yet in
# this repository) must likewise write to a git-ignored build/.
build/
