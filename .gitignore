# Harvest logs (recreated by tools/harvest.py)
*.log

# Python
__pycache__/

# Upstream download cache (tools/fetch-upstream.py --cache-dir)
.cache/

# SQLite: only the committed corpus index is kept; every other *.sqlite3
# (working copies, WAL/journal files) is ignored.  That includes
# kb/kb.sqlite3: at ~570 MB it exceeds GitHub's 100 MiB file limit, so it
# is published as a release asset instead; kb/manifest.json (committed)
# pins its hash and the build is deterministic.
*.sqlite3*
!data/index/corpus.sqlite3

# Scratch build output.  Nothing generated here is committed: the
# include/.def generator (a separate layer on top of kb/, not yet in
# this repository) must likewise write to a git-ignored build/.
build/
