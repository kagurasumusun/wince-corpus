# Harvest logs (recreated by tools/harvest.py)
*.log

# Python
__pycache__/

# Upstream download cache (tools/fetch-upstream.py --cache-dir)
.cache/

# SQLite: only the committed corpus index is kept; every other *.sqlite3
# (working copies, WAL/journal files) is ignored.
*.sqlite3*
!data/index/corpus.sqlite3

# Scratch include/def output (tools/gen-include-def.py --out build/...).
# The curated unified surface lives in winsur/ and IS committed (the
# README's reproducibility note); any other build/ output is scratch,
# never committed.
build/
